#! /bin/sh

if [ "$1" = "--help" ] || [ "$1" = "-h" ] || [ "$1" = "help" ]; then
  cat << EOF
$ bangs
Search in a website through custom duckduckgo bangs.
!yt video query
!lg libgen book query
!klein search local classifieds
Configure your preferred search options and reuse them via ergonomic shortcuts.

Unspecified bangs will fall back to duckduckgo.
Best assigned to a keyboard shortcut.
Leading with a space or using '-' as the bang will search in ddg.

  Commands:
  list: list all available bangs
  BANG QUERY: open the given query for the given bang

Examples:
  $ bangs
  # yt rofi showcase
  # git dotfiles
EOF
  exit
fi

MAIN_BROWSER=$BROWSER
SECONDARY_BROWSER=brave
DEFAULT_BANG="-" # ddg

hash rofi $MAIN_BROWSER node open-i3-workspace || exit 127

bangList() {
  cat $(dirname $0)/banglist
}

if [ "$1" = "list" ]; then
  bangList
  exit 0
fi

prompt() {
  rofi -dmenu -l 0 -theme-str 'window {width: 300px;}' -p \!
}

urlEncode() {
  node -e "console.log( encodeURIComponent( process.argv[1] ) )" "$1"
}

if [ -z "$2" ]; then
  res="$(prompt)"
  [ -z "$res" ] && exit 1
  bang="${res%% *}"
  rawquery="${res#* }"
  [ "$query" = "$bang" ] && bang=$DEFAULT_BANG
else
  bang=$1
  rawquery="$2"
fi
query=`urlEncode "$rawquery"`

# bang specific manipulation
# case "$bang" in
# )
#   $SECONDARY_BROWSER "https://duckduckgo.com/?q=!$bang%20$query" >/dev/null 2>&1 &
#   exit;;
# esac

if bangList | grep -m 1 "^$bang " >/dev/null; then
  bangList | grep -m 1 "^$bang " | cut -d\  -f2- | sed "s|\%s|$query|" | xargs -r -0 $MAIN_BROWSER >/dev/null 2>&1 &
else
  if [ "$bang" = "$DEFAULT_BANG" ] && [ "$DEFAULT_BANG" = "-" ]; then
    $MAIN_BROWSER "https://duckduckgo.com/?q=$query" >/dev/null 2>&1 &
  else
    $MAIN_BROWSER "https://duckduckgo.com/?q=!$bang%20$query" >/dev/null 2>&1 &
  fi
fi
open-i3-workspace 2
